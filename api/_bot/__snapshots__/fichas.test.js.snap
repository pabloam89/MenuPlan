         "jueves": {
          "type": "object",
          "properties": {
           "primero": {
            "type": "string"
           },
           "segundo": {
            "type": "string"
           },
           "postre": {
            "type": "string"
           },
           "sinClase": {
            "type": "boolean"
           }
          },
          "required": [],
