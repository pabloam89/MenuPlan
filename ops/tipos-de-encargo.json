{
  "$comentario": "Los tipos de encargo (#639, #640). Hay CINCO tipos (`assignment_types`: create, fix, improve, operate, audit), cada uno con el esqueleto mínimo de pasos (`skeleton`) que todo su subtipo cumple, y los 17 de siempre, más uno `*-other` por tipo para lo que no encaja (N0 §3, valor desconocido), son sus SUBTIPOS: están en `tipos` (el nombre histórico, que lee el panel de la factoría, repo homenu-panel; no se renombra, y los 17 ids tampoco) y cada uno apunta a su tipo con `type` y anota solo lo suyo (pasos, `cierra_con`, `measure`, `irreversible`, `measured_with`, `builds_in_session`). Cada paso se hace tras el anterior; los agentes de un mismo paso van en paralelo. `opcional` es un agente que solo entra si se cumple su `flag` (vocabulario cerrado `flags`); el texto `si` se queda por compatibilidad con el panel y es el de la bandera. Quien construye no juzga: cada paso de constructor va seguido de un juez distinto y ningún subtipo se queda sin juez, ni siquiera el trivial. La lista de agentes sale de .claude/agents/ (scripts/lib/agentes.mjs), no se copia aquí. Lector único: scripts/lib/tiposDeEncargo.mjs; la tabla «Qué pipeline» de .claude/commands/orquestar.md se GENERA desde este fichero (`npm run flujo -- --escribir`) y ops/tipos-de-encargo.test.js lo compara. La complejidad y el presupuesto viven en ops/presupuestos.json; el lector las junta sin copiarlas. Nombres nuevos en inglés (decisión del 11 oct 2026, ops/DECISIONES.md).",
  "version": 1,
  "actualizado": "2026-10-12",
  "especiales": {
    "sesion": "la sesión principal, sin subagente",
    "constructor": "el constructor del dominio que toque",
    "constructores": "un constructor por cada dominio que toca el encargo"
  },
  "special_roles": {
    "sesion": "planner",
    "constructor": "builder",
    "constructores": "builder"
  },
  "flags": {
    "writes_data": {
      "si": "escribe datos",
      "what": "El encargo escribe datos de familias o de la base"
    },
    "touches_rls": {
      "si": "toca RLS",
      "what": "El encargo cambia políticas RLS o permisos de tablas"
    },
    "changes_bot": {
      "si": "cambia el bot",
      "what": "El encargo cambia lo que Lola dice o hace"
    },
    "touches_secrets_or_permissions": {
      "si": "toca secretos o permisos",
      "what": "El encargo toca secretos, variables de entorno, permisos de Claude o de GitHub"
    }
  },
  "assignment_types": {
    "create": {
      "what": "Algo nuevo o un cambio de lo que hace: pantalla, herramienta, tabla, endpoint, contenido",
      "skeleton": {
        "roles": [
          "builder",
          "judge"
        ]
      }
    },
    "fix": {
      "what": "Algo que debía funcionar y no funciona",
      "skeleton": {
        "roles": [
          "judge",
          "builder",
          "judge"
        ]
      }
    },
    "improve": {
      "what": "Mejorar sin cambiar lo que hace: migrar, simplificar, acelerar, abaratar",
      "skeleton": {
        "roles": [
          "builder",
          "judge"
        ],
        "measures_before_after": true
      }
    },
    "operate": {
      "what": "Operar la casa: CI, permisos, hooks, ramas, secretos, despliegues",
      "skeleton": {
        "roles": [
          "builder",
          "judge"
        ],
        "irreversible_needs_close": true
      }
    },
    "audit": {
      "what": "Mirar sin tocar: solo jueces, en paralelo",
      "skeleton": {
        "roles": [
          "judge"
        ],
        "judges_only_in_parallel": true
      }
    }
  },
