# Plantilla de .env.local con direcciones de 1Password, no claves.
#
#   cp ops/env.1password .env.local      (en cada worktree nuevo)
#
# Las claves de las sesiones viven en la bóveda HoMenu-sesiones (#328); las de
# producción, solo en HoMenu, que la service account de las sesiones no ve.
# Los scripts (scripts/lib/env.mjs) y Vite (vite.config.js) resuelven cada
# op://… al arrancar, con la service account del llavero. Para lo que lee
# process.env a pelo (node --env-file, vercel, etc.):
#
#   npm run op -- run --env-file=.env.local -- <comando>
#
# OJO: Vite resuelve todas las direcciones en una sola llamada a `op inject`.
# Una sola que la service account no pueda leer y fallan la app y los
# scripts enteros: aquí solo van direcciones de HoMenu-sesiones (lo vigila
# scripts/boveda-sesiones.test.js, junto con la lista que copia el script).
#
# Cómo añadir o rotar una clave: .claude/skills/1password/SKILL.md

ANTHROPIC_API_KEY=op://HoMenu-sesiones/Anthropic/ANTHROPIC_API_KEY
AI_GATEWAY_API_KEY=op://HoMenu-sesiones/Vercel AI Gateway/AI_GATEWAY_API_KEY
FAL_KEY=op://HoMenu-sesiones/fal/FAL_KEY
GEMINI_AI_STUDIO_KEY=op://HoMenu-sesiones/Gemini AI Studio/GEMINI_AI_STUDIO_KEY
GROQ_API_KEY=op://HoMenu-sesiones/Groq/GROQ_API_KEY
TRIPO3D_API_KEY=op://HoMenu-sesiones/Tripo3D/TRIPO3D_API_KEY

VITE_SUPABASE_URL=op://HoMenu-sesiones/Supabase/VITE_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=op://HoMenu-sesiones/Supabase/VITE_SUPABASE_ANON_KEY
# Usuario de solo lectura para `npm run consulta` (migración 0092, issue #233).
# Si se archiva la ficha para rotar la contraseña, `op inject` falla entero
# hasta crearla otra vez (y copiarla aquí: node scripts/boveda-sesiones.mjs --si).
SUPABASE_DB_URL_LECTURA=op://HoMenu-sesiones/Supabase lectura/SUPABASE_DB_URL_LECTURA

# Solo Pablo (bóveda HoMenu). Comentadas a propósito: con la service account de
# las sesiones no se leen, y la guardia niega a las sesiones nombrarlas en una
# orden. Pablo las pasa por el entorno, con `!`, por la app de escritorio,
# que le pide aprobar, p. ej.:
#   MENUPLAN_OP_PABLO=1 SUPABASE_DB_URL=op://HoMenu/Supabase/SUPABASE_DB_URL node scripts/apply-migration.mjs <nombre> --si --pablo
# SUPABASE_DB_URL=op://HoMenu/Supabase/SUPABASE_DB_URL
# SUPABASE_ACCESS_TOKEN=op://HoMenu/Supabase/SUPABASE_ACCESS_TOKEN
# BLOB_READ_WRITE_TOKEN=op://HoMenu/Vercel Blob/BLOB_READ_WRITE_TOKEN
# TELEGRAM_BOT_TOKEN=op://HoMenu/Telegram/TELEGRAM_BOT_TOKEN
# TELEGRAM_WEBHOOK_SECRET=op://HoMenu/Telegram/TELEGRAM_WEBHOOK_SECRET
# TELEGRAM_BOT_USERNAME=op://HoMenu/Telegram/TELEGRAM_BOT_USERNAME
# SMTP_GMAIL_USER=op://HoMenu/Gmail SMTP/SMTP_GMAIL_USER
# SMTP_GMAIL_APP_PASSWORD=op://HoMenu/Gmail SMTP/SMTP_GMAIL_APP_PASSWORD
