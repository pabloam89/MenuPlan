{
  "name": "menuplan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:menu": "node scripts/gen-demo-state.mjs && vite --open \"/?demo=1\"",
    "prebuild": "node scripts/validate-catalog.mjs && npm run check:tdz",
    "build": "vite build && node scripts/build-bot-core.mjs",
    "lint": "eslint .",
    "lint:base": "node scripts/lint-base.mjs",
    "preview": "vite preview",
    "pretest": "node scripts/validate-catalog.mjs",
    "test": "vitest run",
    "check:tdz": "eslint src api scripts --config eslint.tdz.config.js",
    "check:catalog": "node scripts/validate-catalog.mjs",
    "build:derived": "vite-node scripts/build-derived.mjs",
    "check:derived": "vite-node scripts/build-derived.mjs --check",
    "audit:catalog": "vite-node scripts/audit-catalog.mjs",
    "audit:ingredients": "node scripts/build-ingredient-catalog.mjs",
    "build:icons": "node scripts/build-nucleo-icons.mjs",
    "check:duplicates": "node scripts/detect-duplicate-dishes.mjs",
    "enrich:steps": "node scripts/enrich-recipe-steps.mjs",
    "check:wording": "node scripts/check-step-wording.mjs",
    "sync:mercadona": "node scripts/mercadona-sync.mjs && node scripts/build-coste.mjs",
    "build:coste": "node scripts/build-coste.mjs",
    "sync:mercadona:cache": "node scripts/mercadona-sync.mjs --cache",
    "bot:panel": "node scripts/bot-panel.mjs",
    "tarea": "node scripts/tarea.mjs",
    "retirar": "node scripts/retirar.mjs",
    "podar": "node scripts/podar.mjs",
    "issues": "node scripts/issues.mjs",
    "verificar:estado": "node scripts/verificar-estado.mjs",
    "op": "node scripts/op.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fal-ai/client": "^1.10.1",
    "@google/genai": "^2.27.0",
    "@supabase/supabase-js": "^2.117.2",
    "@upstash/redis": "^1.39.0",
    "@vercel/functions": "^3.9.11",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@remotion/cli": "^4.0.533",
    "@remotion/google-fonts": "^4.0.533",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/blob": "^2.8.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jimp": "^1.6.1",
    "jsdom": "^30.1.2",
    "pg": "^8.23.1",
    "remotion": "^4.0.520",
    "sharp": "^0.35.5",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
