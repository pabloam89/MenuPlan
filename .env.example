# Local dev (Vite proxy → Anthropic). Copy to .env and fill in your key.
VITE_ANTHROPIC_API_KEY=sk-ant-api03-...

# Vercel production (Settings → Environment Variables). Name must be exact:
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional shared-secret gate for /admin/expenses (api/expense-extract.js).
# Unset = anyone who finds the URL can use the AI extraction (fine for local
# dev/demo). Set in Vercel to require this code in the app's access-code
# prompt before it will call the Anthropic API.
# ADMIN_EXPENSES_TOKEN=choose-a-long-random-string
