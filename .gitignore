# Logs
logs
*.log
# Sí va al repo: el registro de los ensayos de restauración de las copias (#247).
!ops/copias/ensayos.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel
.env*

# Image-generation pipeline — large local-only artifacts (~2.5GB)
/output/
/public/dishes/
dish-gallery/node_modules/
dish-gallery/dist/
dish-gallery/.vercel/
# Midjourney originals (~250MB of 1024x1024 renders). Only the processed output
# under public/ ships; regenerate it with the scripts/make_*_cards.py scripts.
/Avatares/
# Local-only review sheets, synthetic receipts and approval scratch (not app code)
dish-gallery/review/
approvals-live.json
/Tickets Compra Sintéticos/
# Ledgers locales de las pasadas de enriquecimiento (scripts/enrich-recipe-steps.mjs)
scripts/.enrich-base-done.json
scripts/.enrich-parts-done.json
scripts/.enrich-basesteps-done.json

# Salidas de las pruebas de generación de fotos: cientos de MB, fuera de git.
# NO son descartables: costaron dinero (Gemini). Sus copias, en docs/medios.md.
scripts/test-photos/
scripts/prompt-test/

# Caché del CLI de Supabase
supabase/.temp/

# Datos que descarga el agente de fallos (.github/workflows/agente-fallos.yml)
# antes de arrancar. Nunca se commitean: el repo es público.
.ops/

# Vídeos renderizados con Remotion (`npm run video:render`) y su caché de
# bundle. Los mp4 se regeneran; solo se commitea el que acabe usando la app.
/out/
.remotion/

# bancos de pruebas del motor (solver.stress / solver.vs.modelo)
stress.json
vs-modelo.json

# Motor empaquetado para el bot (scripts/build-bot-core.mjs); se regenera en cada build
/api/_bot/core.mjs
/api/_bot/dominiosGustos.json

# Frases reales de usuarios sin revisar (scripts/router-feedback.mjs, scripts/lola-feedback.mjs)
scripts/router-evals-candidatos.json
scripts/bot-evals-candidatos.json

# Resultados de las evals de Lola, un intento por línea (scripts/bot-evals.mjs, #268)
.evals-out/

# Material de trabajo local que no es código de la app: el vídeo (descartado
# el 7 oct) y las capturas y PDFs de feedback de UX.
/video/
/ux feedback/
