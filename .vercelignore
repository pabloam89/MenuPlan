output/
# Proyecto nativo de iOS (Capacitor): solo se compila en un Mac, Vercel no lo necesita.
ios/
public/dishes/
# scripts/ (not scripts) so the negation below can still re-include one file —
# gitignore/vercelignore semantics don't let you un-ignore a file whose parent
# directory itself is excluded, only its contents via a glob.
scripts/*
# Needed at build time: package.json's "prebuild" runs this to gate `vite
# build` on catalog validity (vite build only bundles, never executes app
# code, so this is the only thing that actually fails the build on bad data).
!scripts/validate-catalog.mjs
# El motor del bot se empaqueta en `npm run build` (scripts/build-bot-core.mjs).
!scripts/build-bot-core.mjs
# vite.config.js resuelve las direcciones op:// de .env.local con este lector
# (en Vercel no hay .env.local, pero el import tiene que existir).
!scripts/lib/
scripts/lib/*
!scripts/lib/botCoreConfig.mjs
!scripts/lib/env.mjs
# Prioridad baja de tests y build en local (#284); en Vercel no hace nada, pero el import tiene que existir.
!scripts/lib/prioridad.mjs
# Las banderas de la app por rama (motor, pizarra, guías): vite.config.js las saca de aquí.
!scripts/lib/banderas.mjs
